# Copy this file to .env in the same folder as docker-compose.yml, then fill
# in real values. .env is read automatically by `docker compose` — you don't
# pass it on the command line.

# ---- Database ----
DB_NAME=agriconnect
DB_USERNAME=agriconnect
DB_PASSWORD=agriconnect
DB_ROOT_PASSWORD=rootpass

# ---- JWT ----
# Any string is fine for local dev as long as it's 32+ characters.
# Use a real random secret before this ever runs anywhere but your laptop.
JWT_SECRET=dev-only-secret-change-me-please-32-chars-min

# ---- Razorpay (leave blank to run without payments working) ----
RAZORPAY_KEY=
RAZORPAY_SECRET=

# ---- OpenWeatherMap (leave blank to run without the weather widget working) ----
WEATHER_API_KEY=

# ---- Cloudinary (leave blank to run without image upload working) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_PRESET=

# ---- Mail (leave blank to run without email — OTP/verification mail — working) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Frontend build-time vars ----
# These are what the BROWSER calls, so they must be reachable from your
# machine, not the container network — localhost + the ports docker-compose
# publishes is correct as-is if you're running everything locally.
VITE_API_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080
VITE_APP_NAME=AgriConnect
